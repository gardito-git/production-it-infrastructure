# Three secrets:
#   admin        Grafana/PMM "admin" password, generated by Terraform
#   agent-token  PMM service account token that agents register with. Empty at
#                first: the server creates the token at first boot and stores it
#                here; every agent waits for it.
#   github       GitHub OAuth app (client_id, client_secret) for "Sign in with
#                GitHub". You fill it in by hand (README), so it's never in
#                Terraform code or state.

resource "random_password" "admin" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "admin" {
  # name_prefix adds a random suffix: a deleted secret's name stays reserved for
  # the recovery window, so a fixed name would block destroy + re-create.
  name_prefix             = "${local.name_prefix}/monitoring/admin-"
  description             = "Grafana/PMM admin password (${local.name_prefix})"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "admin" {
  secret_id = aws_secretsmanager_secret.admin.id
  secret_string = jsonencode({
    username = "admin"
    password = random_password.admin.result
    url      = "https://${var.domain_name}"
  })
}

resource "aws_secretsmanager_secret" "agent_token" {
  name_prefix             = "${local.name_prefix}/monitoring/agent-token-"
  description             = "PMM service account token for pmm-agent registration (${local.name_prefix}); written by the monitoring server"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret" "github" {
  name_prefix             = "${local.name_prefix}/monitoring/github-oauth-"
  description             = "GitHub OAuth app for Grafana login (${local.name_prefix}). Set the value by hand."
  recovery_window_in_days = 7
}
