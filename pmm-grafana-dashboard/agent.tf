# The agent installer every other module runs at first boot: this server's
# addresses on top, then agent/monitoring-agent.sh. Rendered here once, so the
# other modules only need one `monitoring` input.
locals {
  agent_script = join("\n", [
    "#!/bin/bash",
    "# Monitoring agent installer, generated by the pmm-grafana-dashboard module.",
    "PMM_HOST=\"${local.private_ip}\"",
    "TOKEN_SECRET_ARN=\"${aws_secretsmanager_secret.agent_token.arn}\"",
    "LOKI_PUSH_URL=\"http://${local.private_ip}:3100/loki/api/v1/push\"",
    "PROMETHEUS_REMOTE_WRITE_URL=\"http://${local.private_ip}:9090/api/v1/write\"",
    "AGENT_AWS_REGION=\"${data.aws_region.current.region}\"",
    "PMM_ENVIRONMENT=\"${var.environment}\"",
    replace(file("${path.module}/agent/monitoring-agent.sh"), "\r\n", "\n"),
  ])
}
