# Passwords and the replica set keyfile, generated by Terraform and read by the
# nodes at boot (never in user data). They're in Terraform state too: keep the
# state private.
#
#   admin_password   the "admin" user (root role): administration, creating app users
#   backup_password  the "backup" user (backup role only), used by the nightly mongodump
#   keyfile          shared secret the members use to authenticate each other;
#                    identical on all 3 nodes, or they refuse to replicate

# special = false: these end up in connection strings and YAML, where characters
# like @ : / need escaping. 32 letters and digits is still ~190 bits.
resource "random_password" "admin" {
  length  = 32
  special = false
}

resource "random_password" "backup" {
  length  = 32
  special = false
}

# MongoDB keyfiles: 6-1024 characters from the base64 set. Letters and digits
# qualify.
resource "random_password" "keyfile" {
  length  = 756
  special = false
}

resource "aws_secretsmanager_secret" "mongodb" {
  # name_prefix adds a random suffix: a deleted secret's name stays reserved for
  # the recovery window, so a fixed name would block destroy + re-create.
  name_prefix             = "${local.name_prefix}/mongodb/"
  description             = "MongoDB replica set ${local.name_prefix}: passwords, keyfile, connection details"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "mongodb" {
  secret_id = aws_secretsmanager_secret.mongodb.id
  secret_string = jsonencode({
    admin_username  = "admin"
    admin_password  = random_password.admin.result
    backup_username = "backup"
    backup_password = random_password.backup.result
    keyfile         = random_password.keyfile.result
    replica_set     = var.replica_set_name
    hosts           = [for ip in local.node_ips : "${ip}:27017"]
  })
}
