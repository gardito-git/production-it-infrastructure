# One password for Redis, replication and Sentinel, generated by Terraform and
# read by the nodes at boot (never in user data). It's in Terraform state too:
# keep the state private.

# special = false: it ends up in config files and redis:// URLs, where characters
# like # @ / need escaping. 32 letters and digits is still ~190 bits of entropy.
resource "random_password" "redis" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "redis" {
  # name_prefix adds a random suffix: a deleted secret's name stays reserved for
  # the recovery window, so a fixed name would block destroy + re-create.
  name_prefix             = "${local.name_prefix}/redis/"
  description             = "Redis Sentinel cluster ${local.name_prefix}: password and connection details"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "redis" {
  secret_id = aws_secretsmanager_secret.redis.id
  secret_string = jsonencode({
    password             = random_password.redis.result
    sentinel_master_name = var.sentinel_master_name
    sentinels            = [for ip in local.node_ips : "${ip}:26379"]
  })
}
