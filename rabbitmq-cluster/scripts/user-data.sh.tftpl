#!/bin/bash
# Terraform renders this template once per instance (templatefile in compute.tf).
# It writes the node's settings and the scripts from this folder to disk, then
# runs bootstrap.sh. Output goes to /var/log/rabbitmq-bootstrap.log.
# No passwords here: the scripts read them from Secrets Manager at boot.
set -euo pipefail
mkdir -p /etc/rabbitmq-bootstrap /opt/rabbitmq-bootstrap

cat >/etc/rabbitmq-bootstrap/env <<'RABBITMQ_ENV_EOF'
NODE_INDEX="${node_index}"
NODE_NAME="rabbitmq-${node_index + 1}"
AWS_REGION="${aws_region}"
CLUSTER_NAME="${cluster_name}"
NODE_IPS="${node_ips}"
RABBITMQ_VERSION="${rabbitmq_version}"
SECRET_ARN="${secret_arn}"
BACKUP_BUCKET="${backup_bucket}"
BACKUP_PREFIX="${backup_prefix}"
RABBITMQ_ENV_EOF

%{ for name, body in scripts ~}
cat >/opt/rabbitmq-bootstrap/${name} <<'RABBITMQ_SCRIPT_EOF'
${body}
RABBITMQ_SCRIPT_EOF
chmod 0755 /opt/rabbitmq-bootstrap/${name}

%{ endfor ~}
/opt/rabbitmq-bootstrap/bootstrap.sh 2>&1 | tee -a /var/log/rabbitmq-bootstrap.log
