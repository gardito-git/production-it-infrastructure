# The admin password and the Erlang cookie, generated by Terraform and read by
# the nodes at boot (never in user data). Both are in Terraform state too:
# keep the state private.
#
#   password       the "admin" user (management UI, creating app users)
#   erlang_cookie  shared secret the nodes use to trust each other; it must be
#                  identical on all 3 nodes, or they refuse to cluster

# special = false: these end up in config files and amqp:// URLs, where
# characters like # @ / need escaping. 32 letters and digits is still ~190 bits.
resource "random_password" "admin" {
  length  = 32
  special = false
}

resource "random_password" "erlang_cookie" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "rabbitmq" {
  # name_prefix adds a random suffix: a deleted secret's name stays reserved for
  # the recovery window, so a fixed name would block destroy + re-create.
  name_prefix             = "${local.name_prefix}/rabbitmq/"
  description             = "RabbitMQ cluster ${local.name_prefix}: admin password, Erlang cookie, connection details"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "rabbitmq" {
  secret_id = aws_secretsmanager_secret.rabbitmq.id
  secret_string = jsonencode({
    username       = "admin"
    password       = random_password.admin.result
    erlang_cookie  = random_password.erlang_cookie.result
    amqp_hosts     = [for ip in local.node_ips : "${ip}:5672"]
    management_url = "http://${local.node_ips[0]}:15672"
  })
}
