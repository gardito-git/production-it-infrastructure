# Passwords are generated by Terraform, stored in Secrets Manager, and read by
# the nodes at boot, so they never appear in user data (which anyone with
# ec2:DescribeInstanceAttribute can read). They are in Terraform state too:
# keep the state private.

# special = false: these end up in YAML and connection strings, where characters
# like # : @ / need escaping. 32 letters and digits is still ~190 bits of entropy.
resource "random_password" "superuser" {
  length  = 32
  special = false
}

resource "random_password" "replication" {
  length  = 32
  special = false
}

resource "random_password" "patroni_api" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "postgres" {
  # name_prefix adds a random suffix: a deleted secret's name stays reserved for
  # the recovery window, so a fixed name would block destroy + re-create.
  name_prefix             = "${local.name_prefix}/postgres/"
  description             = "PostgreSQL cluster ${local.name_prefix}: superuser, replication and Patroni API credentials"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "postgres" {
  secret_id = aws_secretsmanager_secret.postgres.id
  secret_string = jsonencode({
    superuser_username   = "postgres"
    superuser_password   = random_password.superuser.result
    replication_username = "replicator"
    replication_password = random_password.replication.result
    patroni_api_username = "patroni"
    patroni_api_password = random_password.patroni_api.result
    host                 = aws_lb.postgres.dns_name
    port                 = 5432 # read-write, always the primary
    read_only_port       = 5433 # replicas
  })
}
