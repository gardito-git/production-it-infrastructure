# Harbor's admin and database passwords, generated by Terraform and read by the
# server at boot (never in user data). They're in Terraform state too: keep the
# state private.

# special = false: they end up in YAML and connection strings.
resource "random_password" "admin" {
  length  = 32
  special = false
}

resource "random_password" "database" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "harbor" {
  # name_prefix adds a random suffix: a deleted secret's name stays reserved for
  # the recovery window, so a fixed name would block destroy + re-create.
  name_prefix             = "${local.name_prefix}/harbor/"
  description             = "Harbor ${local.name_prefix}: admin and database passwords"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "harbor" {
  secret_id = aws_secretsmanager_secret.harbor.id
  secret_string = jsonencode({
    admin_username    = "admin"
    admin_password    = random_password.admin.result
    database_password = random_password.database.result
    url               = "https://${var.domain_name}"
  })
}
